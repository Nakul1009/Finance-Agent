# FinBank AI Environment Variables Configuration

# NVIDIA Nemotron LLM Credentials (Optional for local rule-based mode, required for LLM enhanced mode)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1

# Storage & Database
DATABASE_URL=sqlite:///./finbank.db
UPLOAD_DIR=./uploads
